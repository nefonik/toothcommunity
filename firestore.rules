rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Servers & Channels
    match /servers/{serverId} {
      allow read: if true;
      allow write: if true;

      match /channels/{channelId} {
        allow read: if true;
        allow write: if true;

        match /messages/{messageId} {
          allow read: if true;
          allow write: if true;
        }
      }
    }

    // 3. Flat channel messages collection for real-time E2EE chat
    match /channel_messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. WebRTC 1-on-1 Calls Signaling
    match /calls/{callId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. WebRTC Voice Room Mesh Signaling
    match /voice_rooms/{roomId}/peers/{peerId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Global Banned Users & Blacklist
    match /banned_users/{banId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
